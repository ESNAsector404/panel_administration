# ============================================
# Sector 404 — Back-end : variables d'environnement (modèle)
# Copier en `.env` et renseigner les valeurs. NE PAS committer le .env réel.
# ============================================

NODE_ENV=development
PORT=4000

# --- Base de données ---
# Vraie instance Mongo, ou « memory » pour une base en mémoire (démo sans install).
MONGODB_URI=mongodb://localhost:27017/sector404

# --- Secrets JWT (≥ 32 caractères chacun) ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- CORS / Cookies ---
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# --- Comptes initiaux (seed) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@sector404.local
SEED_ADMIN_PASSWORD=
SEED_USER_USERNAME=operateur
SEED_USER_EMAIL=operateur@sector404.local
SEED_USER_PASSWORD=
